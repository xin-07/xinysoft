# ==================== 数据库配置（二选一） ====================

# ---- PostgreSQL（当前使用）----
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=xinysoftdb
DB_SSLMODE=prefer

# ---- MySQL（旧方案）----
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your_password
# DB_NAME=xinysoft

# JWT 密钥 — 使用 openssl rand -hex 32 生成一个随机密钥
JWT_SECRET_KEY=your_jwt_secret_key_here

# GitHub Webhook 密钥（与 GitHub 仓库 Webhook 配置中的 Secret 保持一致）
WEBHOOK_SECRET=your_webhook_secret_here

# 文件上传根目录
UPLOAD_DIR=D:\Project\web\xinysoft_Vite\public